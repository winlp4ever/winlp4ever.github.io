---
import { render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Katex from '../../components/Katex.astro'
import { SITE, frDate, isoDate, minutes } from '../../lib/site'
import { published, type Post } from '../../lib/posts'
import '@fontsource/architects-daughter/400.css'
import '../../styles/post.css'

export async function getStaticPaths() {
  const posts = await published()
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, newer: posts[i - 1], older: posts[i + 1] } }))
}
interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props
const { Content, headings } = await render(post)
const d = post.data
const mins = minutes(post.body)
const toc = headings.filter((h) => h.depth === 2)
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: isoDate(d.date),
  dateModified: isoDate(d.updated ?? d.date),
  image: `${SITE.url}/og-default.png`,
  author: { '@type': 'Person', name: SITE.author, url: SITE.url },
  keywords: d.tags.join(', '),
  url: `${SITE.url}/blog/${post.id}/`,
  inLanguage: 'en',
}
---
<BaseLayout title={d.title} description={d.description} type="article" jsonld={jsonld} reading={{ minutes: mins, figures: d.figures }}>
  {d.math && <Katex />}
  <article data-slug={post.id}>
    <header class="post-head measure">
      <a class="back" href="/">← {SITE.name}</a>
      <div class="kicker">
        <time datetime={isoDate(d.date)}>{frDate(d.date)}</time>
        {d.updated && <span>revised {frDate(d.updated)}</span>}
        <span>{mins} min</span>
        {d.figures > 0 && <span><i class="dot"></i>{d.figures} live figures</span>}
        {d.tags.map((t) => <span>#{t}</span>)}
      </div>
      <h1>{d.title}</h1>
      <p class="dek">{d.description}</p>
      <hr class="post-rule" /><hr class="post-rule" />
      {toc.length > 2 && (
        <ol class="toc" aria-label="Contents">
          {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      )}
    </header>
    <div class="prose post">
      <Content />
    </div>
    <nav class="post-end measure" aria-label="More posts">
      {older ? <a href={`/blog/${older.id}/`}><span class="label">← older</span><b>{older.data.title}</b></a> : <span></span>}
      {newer ? <a class="nx" href={`/blog/${newer.id}/`}><span class="label">newer →</span><b>{newer.data.title}</b></a> : <a class="nx" href="/"><span class="label">all writing →</span><b>{SITE.name}</b></a>}
    </nav>
  </article>
</BaseLayout>

<script>
  // figures load only when the first one comes near the viewport
  const mods = import.meta.glob('../../figures/*.js')
  const art = document.querySelector<HTMLElement>('article[data-slug]')
  const load = art && mods[`../../figures/${art.dataset.slug}.js`]
  const figs = document.querySelectorAll('[data-fig]')
  if (load && figs.length) {
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { io.disconnect(); load() }
    }, { rootMargin: '600px' })
    figs.forEach((f) => io.observe(f))
  }
</script>
